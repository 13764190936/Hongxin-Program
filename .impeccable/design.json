      "css": ".ds-primary{font-family:-apple-system, BlinkMacSystemFont, \"PingFang SC\", \"Microsoft YaHei\", sans-serif;font-size:16px;cursor:pointer;border:0;background:var(--accent,#175cff);color:#ffffff;padding:14px 24px;min-height:54px;border-radius:12px;font-weight:650;width:100%}.ds-primary:hover{background:#0046dc}.ds-primary:focus-visible{outline:3px solid var(--focus,#111111);outline-offset:5px}.ds-primary:disabled{opacity:.5;cursor:not-allowed}.ds-primary:active{transform:translateY(1px)}"
